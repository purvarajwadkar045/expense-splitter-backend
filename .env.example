# PostgreSQL Database Settings
# Replace user, password, host, port, and database name with your values.
DATABASE_URL="postgresql://username:password@localhost:5432/expense_splitter"

# Security Configurations
# Secret key should be a cryptographically secure random string.
SECRET_KEY="your-cryptographic-secure-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Configurations (Gmail SMTP settings template)
# Provide a valid email and application password (not your account password, use Google App Passwords).
EMAIL="your-sender-email@gmail.com"
EMAIL_PASSWORD="your-google-app-password"

# Set to True for debug logging
DEBUG=False
